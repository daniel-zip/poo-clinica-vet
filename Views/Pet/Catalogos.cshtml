@model VetCare.Models.ViewModels.Pet.CatalogosViewModel
@{
    ViewData["Title"] = "Catálogos";
    var especies = Model.Especies.ToDictionary(especie => especie.Id, especie => especie.Nome);
}

<div class="area-panel">
    <h1>Catálogos</h1>
    @if (TempData["CatalogosMensagem"] is string mensagem)
    {
        <p role="status">@mensagem</p>
    }

    <section aria-labelledby="especies">
        <h2 id="especies">Espécies</h2>
        <form asp-action="CadastrarEspecie" method="post">
            <div class="tutor-field">
                <label asp-for="Especie.Nome"></label>
                <input asp-for="Especie.Nome" required />
                <span asp-validation-for="Especie.Nome" class="tutor-error"></span>
            </div>
            <button class="switch-button" type="submit">Cadastrar espécie</button>
        </form>

        @if (Model.Especies.Count == 0)
        {
            <p>Nenhuma espécie cadastrada.</p>
        }
        else
        {
            <ul>
                @foreach (var especie in Model.Especies)
                {
                    <li>@especie.Nome</li>
                }
            </ul>
        }
    </section>

    <section aria-labelledby="racas">
        <h2 id="racas">Raças</h2>
        @if (Model.Especies.Count == 0)
        {
            <p>Cadastre uma espécie para poder adicionar raças.</p>
        }
        else
        {
            <form asp-action="CadastrarRaca" method="post">
                <div class="tutor-field">
                    <label asp-for="Raca.Nome"></label>
                    <input asp-for="Raca.Nome" required />
                    <span asp-validation-for="Raca.Nome" class="tutor-error"></span>
                </div>
                <div class="tutor-field">
                    <label asp-for="Raca.EspecieId"></label>
                    <select asp-for="Raca.EspecieId" required>
                        <option value="">Selecione uma espécie</option>
                        @foreach (var especie in Model.Especies)
                        {
                            <option value="@especie.Id">@especie.Nome</option>
                        }
                    </select>
                    <span asp-validation-for="Raca.EspecieId" class="tutor-error"></span>
                </div>
                <button class="switch-button" type="submit">Cadastrar raça</button>
            </form>
        }

        @if (Model.Racas.Count > 0)
        {
            <ul>
                @foreach (var raca in Model.Racas)
                {
                    <li>@raca.Nome (@especies[raca.EspecieId])</li>
                }
            </ul>
        }
        else
        {
            <p>Nenhuma raça cadastrada.</p>
        }
    </section>
</div>
