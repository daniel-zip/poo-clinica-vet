@model VetCare.Models.ViewModels.Pet.CatalogosViewModel
@{
    ViewData["Title"] = "Catálogos";
    var especies = Model.Especies.ToDictionary(especie => especie.Id, especie => especie.Nome);
}

<div class="area-panel">
    <header class="registro-cabecalho">
        <h1>Catálogos</h1>
        <a class="botao-secundario" asp-controller="Pet" asp-action="SugestoesCatalogo">Revisar sugestões</a>
    </header>
    @if (TempData["CatalogosMensagem"] is string mensagem)
    {
        <p class="registro-aviso" role="status">@mensagem</p>
    }

    <section class="registro-secao registro-catalogo" aria-labelledby="especies">
        <h2 id="especies">Espécies</h2>
        <form class="registro-formulario" asp-action="CadastrarEspecie" method="post">
            <div class="formulario-campo">
                <label asp-for="Especie.Nome"></label>
                <input asp-for="Especie.Nome" required />
                <span asp-validation-for="Especie.Nome" class="registro-erro"></span>
            </div>
            <div class="registro-botoes">
                <button class="botao-primario" type="submit">Cadastrar espécie</button>
            </div>
        </form>

        @if (Model.Especies.Count == 0)
        {
            <p class="registro-vazio">Nenhuma espécie cadastrada.</p>
        }
        else
        {
            <ul class="registro-quadro registro-lista">
                @foreach (var especie in Model.Especies)
                {
                    <li>@especie.Nome</li>
                }
            </ul>
        }
    </section>

    <section class="registro-secao registro-catalogo" aria-labelledby="racas">
        <h2 id="racas">Raças</h2>
        @if (Model.Especies.Count == 0)
        {
            <p class="registro-aviso">Cadastre uma espécie para poder adicionar raças.</p>
        }
        else
        {
            <form class="registro-formulario" asp-action="CadastrarRaca" method="post">
                <div class="formulario-campo">
                    <label asp-for="Raca.Nome"></label>
                    <input asp-for="Raca.Nome" required />
                    <span asp-validation-for="Raca.Nome" class="registro-erro"></span>
                </div>
                <div class="formulario-campo">
                    <label asp-for="Raca.EspecieId"></label>
                    <select asp-for="Raca.EspecieId" required>
                        <option value="">Selecione uma espécie</option>
                        @foreach (var especie in Model.Especies)
                        {
                            <option value="@especie.Id">@especie.Nome</option>
                        }
                    </select>
                    <span asp-validation-for="Raca.EspecieId" class="registro-erro"></span>
                </div>
                <div class="registro-botoes">
                    <button class="botao-primario" type="submit">Cadastrar raça</button>
                </div>
            </form>
        }

        @if (Model.Racas.Count > 0)
        {
            <ul class="registro-quadro registro-lista">
                @foreach (var raca in Model.Racas)
                {
                    <li><strong>@raca.Nome</strong><span>@especies[raca.EspecieId]</span></li>
                }
            </ul>
        }
        else
        {
            <p class="registro-vazio">Nenhuma raça cadastrada.</p>
        }
    </section>
</div>
