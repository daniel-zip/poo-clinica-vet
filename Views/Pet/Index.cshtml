@model IReadOnlyList<VetCare.Models.ViewModels.Pet.PetResumoViewModel>
@{
    var areaClinica = Context.Request.Query["areaClinica"] == "veterinario" ? "veterinario" : null;
    var titulo = areaClinica is not null ? "Histórico por pet" : "Pets";
    ViewData["Title"] = titulo;
}

<section class="area-panel registro-listagem" aria-labelledby="titulo-pets" data-lista-filtravel>
    <header class="registro-cabecalho">
        <div>
            <h1 id="titulo-pets">@titulo</h1>
            @if (Model.Count > 0)
            {
                <p>@Model.Count @(Model.Count == 1 ? "pet cadastrado" : "pets cadastrados")</p>
            }
        </div>
        <div class="registro-botoes">
            <a class="botao-secundario" asp-controller="Home" asp-action="Index"
               asp-fragment="@(areaClinica ?? "recepcao")">
                @(areaClinica is null ? "Voltar à Recepção" : "Voltar à área Veterinário")
            </a>
            @if (areaClinica is null)
            {
                <a class="botao-primario" asp-controller="Pet" asp-action="Cadastrar" data-acao-recepcao>
                    <span aria-hidden="true">+</span> Cadastrar pet
                </a>
            }
        </div>
    </header>

    @if (TempData["PetMensagem"] is string mensagem) { <p role="status">@mensagem</p> }
    @if (TempData["PetErro"] is string erro) { <p class="registro-erro" role="alert">@erro</p> }

    @if (Model.Count == 0)
    {
        <p class="registro-vazio">Nenhum pet cadastrado.</p>
    }
    else
    {
        <partial name="_FiltrosLista" model='new FiltrosListaViewModel("pets", "Nome do pet, tutor ou raça",
            new FiltroLista("especie", "Espécie", Model.Select(item => item.Especie)))' />
        <div class="registro-quadro" role="region" aria-label="Lista de pets" tabindex="0">
            <table class="registro-tabela">
                <thead>
                    <tr><th scope="col">Nome</th><th scope="col">Tutor</th><th scope="col">Espécie e raça</th><th scope="col">Ações</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-lista-item="@($"{item.Pet.Nome} {item.Tutor} {item.Raca}")" data-filtro-especie="@item.Especie">
                            <th scope="row">@item.Pet.Nome</th>
                            <td>@item.Tutor</td>
                            <td>@item.Especie · @item.Raca</td>
                            <td>
                                <div class="registro-acoes">
                                    <a asp-controller="Pet" asp-action="Detalhes" asp-route-id="@item.Pet.Id"
                                       asp-route-areaClinica="@areaClinica" aria-label="Detalhes de @item.Pet.Nome">Detalhes</a>
                                    @if (areaClinica is not null)
                                    {
                                        <a asp-controller="Consulta" asp-action="HistoricoPorPet" asp-route-id="@item.Pet.Id"
                                           asp-route-areaClinica="@areaClinica" aria-label="Histórico de @item.Pet.Nome">Ver histórico</a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Pet" asp-action="Editar" asp-route-id="@item.Pet.Id"
                                           aria-label="Editar @item.Pet.Nome" data-acao-recepcao>Editar</a>
                                        <a class="acao-perigosa" asp-controller="Pet" asp-action="Excluir" asp-route-id="@item.Pet.Id"
                                           aria-label="Excluir @item.Pet.Nome" data-acao-recepcao>Excluir</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
