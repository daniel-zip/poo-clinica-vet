@model VetCare.Models.ViewModels.Pet.PetFormularioViewModel
@{ ViewData["Title"] = "Editar pet"; }

<section class="area-panel">
    <header class="registro-cabecalho">
        <div>
            <h1>Editar pet</h1>

            @if (ViewData["TutorOrigemId"] is int)
            {
                <p>Selecione o novo tutor no campo Tutor e salve.</p>
            }
        </div>
    </header>
    <form class="registro-formulario" asp-action="Editar" asp-route-id="@ViewData["PetId"]"
          asp-route-tutorOrigemId="@ViewData["TutorOrigemId"]" method="post">
        <partial name="_Formulario" model="Model" />
    </form>
</section>
