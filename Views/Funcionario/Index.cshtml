@model IReadOnlyList<Funcionario>
@{
    ViewData["Title"] = "Funcionários";
}

<section class="area-panel registro-listagem" aria-labelledby="titulo-funcionarios">
    <header class="registro-cabecalho">
        <div>
            <h1 id="titulo-funcionarios">Funcionários</h1>
            @if (Model.Count > 0)
            {
                <p>@Model.Count @(Model.Count == 1 ? "funcionário cadastrado" : "funcionários cadastrados")</p>
            }
        </div>
        <a class="botao-primario" asp-action="Cadastrar"><span aria-hidden="true">+</span> Cadastrar funcionário</a>
    </header>

    @if (TempData["FuncionarioMensagem"] is string mensagem)
    {
        <p role="status">@mensagem</p>
    }

    @if (Model.Count == 0)
    {
        <p class="registro-vazio">Nenhum funcionário cadastrado.</p>
    }
    else
    {
        <div class="registro-quadro" role="region" aria-label="Lista de funcionários" tabindex="0">
            <table class="registro-tabela">
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Cargo</th>
                        <th scope="col">Situação</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var funcionario in Model)
                    {
                        var cargo = funcionario switch
                        {
                            Veterinario => "Veterinário",
                            Recepcionista => "Recepcionista",
                            Administrador => "Administrador",
                            _ => funcionario.GetType().Name
                        };
                        <tr>
                            <th scope="row">@funcionario.Nome</th>
                            <td>@cargo</td>
                            <td>@(funcionario.Ativo ? "Ativo" : "Desativado")</td>
                            <td>
                                <div class="registro-acoes">
                                    <a asp-action="Detalhes" asp-route-id="@funcionario.Id"
                                       aria-label="Detalhes de @funcionario.Nome">Detalhes</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
