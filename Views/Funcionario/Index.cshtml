@model IReadOnlyList<Funcionario>
@{
    ViewData["Title"] = "Funcionários";
    string ExibirCargo(Funcionario funcionario) => funcionario is Veterinario ? "Veterinário" : funcionario.GetType().Name;
}

<section class="area-panel registro-listagem" aria-labelledby="titulo-funcionarios" data-lista-filtravel>
    <header class="registro-cabecalho">
        <div>
            <h1 id="titulo-funcionarios">Funcionários</h1>
            @if (Model.Count > 0)
            {
                <p>@Model.Count @(Model.Count == 1 ? "funcionário cadastrado" : "funcionários cadastrados")</p>
            }
        </div>
        <div class="registro-botoes">
            <a class="botao-secundario" asp-controller="Home" asp-action="Index"
               asp-fragment="administracao">Voltar à Administração</a>
            <a class="botao-primario" asp-action="Cadastrar"><span aria-hidden="true">+</span> Cadastrar funcionário</a>
        </div>
    </header>

    @if (TempData["FuncionarioMensagem"] is string mensagem)
    {
        <p role="status">@mensagem</p>
    }

    @if (Model.Count == 0)
    {
        <p class="registro-vazio">Nenhum funcionário cadastrado.</p>
    }
    else
    {
        <partial name="_FiltrosLista" model='new FiltrosListaViewModel("funcionarios", "Nome do funcionário",
            new FiltroLista("cargo", "Cargo", Model.Select(ExibirCargo)),
            new FiltroLista("situacao", "Situação", ["Ativo", "Desativado"]))' />
        <div class="registro-quadro" role="region" aria-label="Lista de funcionários" tabindex="0">
            <table class="registro-tabela">
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Cargo</th>
                        <th scope="col">Situação</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var funcionario in Model)
                    {
                        var cargo = ExibirCargo(funcionario);
                        var situacao = funcionario.Ativo ? "Ativo" : "Desativado";
                        <tr data-lista-item="@funcionario.Nome" data-filtro-cargo="@cargo" data-filtro-situacao="@situacao">
                            <th scope="row">@funcionario.Nome</th>
                            <td>@cargo</td>
                            <td>@situacao</td>
                            <td>
                                <div class="registro-acoes">
                                    <a asp-action="Detalhes" asp-route-id="@funcionario.Id"
                                       aria-label="Detalhes de @funcionario.Nome">Detalhes</a>
                                    <a asp-action="Editar" asp-route-id="@funcionario.Id"
                                       aria-label="Editar @funcionario.Nome">Editar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
