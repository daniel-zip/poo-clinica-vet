@model VetCare.Models.Tutor
@{
    ViewData["Title"] = "Detalhes do tutor";
}

<section class="area-panel">
    <h1>@Model.Nome</h1>
    <dl>
        <dt>CPF</dt>
        <dd>@Model.Cpf</dd>
        <dt>Telefone</dt>
        <dd>@Model.Telefone</dd>
    </dl>

    <h2>Pets vinculados</h2>
    @if (Model.Pets.Count == 0)
    {
        <p>Este tutor ainda não tem pets cadastrados.</p>
    }
    else
    {
        <ul>
            @foreach (var pet in Model.Pets)
            {
                <li><a asp-controller="Pet" asp-action="Detalhes" asp-route-id="@pet.Id">@pet.Nome</a></li>
            }
        </ul>
    }

    <div class="tutor-actions">
        <a class="switch-button tutor-button" asp-action="Editar" asp-route-id="@Model.Id">Editar tutor</a>
        <a asp-action="Index">Voltar à lista</a>
    </div>
</section>
