@model VetCare.Models.ViewModels.Tutor.TutorFormularioViewModel

<div asp-validation-summary="ModelOnly" class="tutor-error" role="alert"></div>

<div class="tutor-field">
    <label asp-for="Nome"></label>
    <input asp-for="Nome" required />
    <span asp-validation-for="Nome" class="tutor-error"></span>
</div>

<div class="tutor-field">
    <label asp-for="Cpf"></label>
    <input asp-for="Cpf" inputmode="numeric" maxlength="14" required />
    <span asp-validation-for="Cpf" class="tutor-error"></span>
</div>

<div class="tutor-field">
    <label asp-for="Telefone"></label>
    <input asp-for="Telefone" type="tel" required />
    <span asp-validation-for="Telefone" class="tutor-error"></span>
</div>

<div class="tutor-actions">
    <button class="switch-button" type="submit">Salvar</button>
    <a asp-action="Index">Cancelar</a>
</div>
