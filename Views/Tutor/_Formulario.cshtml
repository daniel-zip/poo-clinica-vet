@model VetCare.Models.ViewModels.Tutor.TutorFormularioViewModel

<div asp-validation-summary="ModelOnly" class="registro-erro" role="alert"></div>

<div class="formulario-campo">
    <label asp-for="Nome"></label>
    <input asp-for="Nome" required />
    <span asp-validation-for="Nome" class="registro-erro"></span>
</div>

<div class="formulario-campo">
    <label asp-for="Cpf"></label>
    <input asp-for="Cpf" inputmode="numeric" placeholder="000.000.000-00" data-mascara="cpf" required />
    <span asp-validation-for="Cpf" class="registro-erro"></span>
</div>

<div class="formulario-campo">
    <label asp-for="Telefone"></label>
    <input asp-for="Telefone" type="tel" autocomplete="tel-national" placeholder="(00) 00000-0000" data-mascara="telefone" required />
    <span asp-validation-for="Telefone" class="registro-erro"></span>
</div>

<div class="registro-botoes">
    <button class="botao-primario" type="submit">Salvar</button>
    @if (ViewData["VoltarFicha"] is true)
    {
        <a class="botao-secundario" asp-action="Detalhes" asp-route-id="@ViewData["TutorId"]">Voltar à ficha</a>
    }
    else
    {
        <a class="botao-secundario" asp-action="Index">Voltar à lista</a>
    }
</div>
