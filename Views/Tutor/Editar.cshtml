@model VetCare.Models.ViewModels.Tutor.TutorFormularioViewModel
@{
    ViewData["Title"] = "Editar tutor";
}

<section class="area-panel">
    <header class="registro-cabecalho">
        <div>
            <h1>Editar tutor</h1>
        </div>
    </header>
    <form class="registro-formulario" asp-action="Editar" asp-route-id="@ViewData["TutorId"]" method="post">
        <partial name="_Formulario" model="Model" />
    </form>
</section>
