@model IReadOnlyList<VetCare.Models.Tutor>
@{
    ViewData["Title"] = "Tutores";
}

<section class="area-panel registro-listagem" aria-labelledby="titulo-tutores">
    <header class="registro-cabecalho">
        <div>
            <h1 id="titulo-tutores">Tutores</h1>
            @if (Model.Count > 0)
            {
                <p>@Model.Count @(Model.Count == 1 ? "tutor cadastrado" : "tutores cadastrados")</p>
            }
        </div>
        <a class="botao-primario" asp-action="Cadastrar">
            <span aria-hidden="true">+</span> Cadastrar tutor
        </a>
    </header>

    @if (TempData["TutorMensagem"] is string mensagem)
    {
        <p role="status">@mensagem</p>
    }
    @if (TempData["TutorErro"] is string erro)
    {
        <p class="registro-erro" role="alert">@erro</p>
    }

    @if (Model.Count == 0)
    {
        <p class="registro-vazio">Nenhum tutor cadastrado.</p>
    }
    else
    {
        <div class="registro-quadro" role="region" aria-label="Lista de tutores" tabindex="0">
            <table class="registro-tabela">
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">CPF</th>
                        <th scope="col">Telefone</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tutor in Model)
                    {
                        <tr>
                            <th scope="row">@tutor.Nome</th>
                            <td class="registro-contato">@FormatoContato.ExibirCpf(tutor.Cpf)</td>
                            <td class="registro-contato">@FormatoContato.ExibirTelefone(tutor.Telefone)</td>
                            <td>
                                <div class="registro-acoes">
                                    <a asp-action="Detalhes" asp-route-id="@tutor.Id" aria-label="Detalhes de @tutor.Nome">Detalhes</a>
                                    <a asp-action="Editar" asp-route-id="@tutor.Id" aria-label="Editar @tutor.Nome">Editar</a>
                                    <a class="acao-perigosa" asp-action="Excluir" asp-route-id="@tutor.Id" aria-label="Excluir @tutor.Nome">Excluir</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
