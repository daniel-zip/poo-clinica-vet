@model IReadOnlyList<VetCare.Models.Tutor>
@{
    ViewData["Title"] = "Tutores";
}

<section class="area-panel">
    <div class="tutor-heading">
        <h1>Tutores</h1>
        <a class="switch-button tutor-button" asp-action="Cadastrar">Cadastrar tutor</a>
    </div>

    @if (TempData["TutorMensagem"] is string mensagem)
    {
        <p role="status">@mensagem</p>
    }
    @if (TempData["TutorErro"] is string erro)
    {
        <p class="tutor-error" role="alert">@erro</p>
    }

    @if (Model.Count == 0)
    {
        <p>Nenhum tutor cadastrado.</p>
    }
    else
    {
        <div class="tutor-table-wrap">
            <table class="tutor-table">
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">CPF</th>
                        <th scope="col">Telefone</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tutor in Model)
                    {
                        <tr>
                            <td>@tutor.Nome</td>
                            <td>@tutor.Cpf</td>
                            <td>@tutor.Telefone</td>
                            <td class="tutor-actions">
                                <a asp-action="Editar" asp-route-id="@tutor.Id" aria-label="Editar @tutor.Nome">Editar</a>
                                <a asp-action="Excluir" asp-route-id="@tutor.Id" aria-label="Excluir @tutor.Nome">Excluir</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
