@model IReadOnlyList<VetCare.Models.ViewModels.Consulta.ConsultaResumoViewModel>
@using VetCare.Models.Enums
@{
    var mostrarPet = ViewData["MostrarPet"] is not false;
    var areaClinica = ViewData["AreaClinica"] as string;
    var veterinarioSelecionadoId = ViewData["VeterinarioSelecionadoId"] as int?;
    var navegacao = ViewData["NavegacaoAgenda"] as NavegacaoAgenda ?? new(areaClinica, null, null);
    var filtros = new List<FiltroLista>();
    if (!mostrarPet)
        filtros.Add(new FiltroLista("veterinario", "Veterinário", Model.Select(consulta => consulta.VeterinarioNome)));
    if (!mostrarPet)
        filtros.Add(new FiltroLista("status", "Status", Enum.GetNames<StatusConsulta>()));
    filtros.Add(new FiltroLista("urgencia", "Urgência", ["Sim", "Não"]));
    var filtrosConsultas = new FiltrosListaViewModel("consultas", mostrarPet ? "Nome do pet" : "Data da consulta (dd/mm/aaaa)", filtros.ToArray());
}

<partial name="_FiltrosLista" model="filtrosConsultas" />
<div class="registro-quadro" role="region" aria-label="Lista de consultas" tabindex="0">
    <table class="registro-tabela">
        <thead>
            <tr>
                <th scope="col">Data e horário</th>
                @if (mostrarPet)
                {
                    <th scope="col">Pet</th>
                }
                <th scope="col">Veterinário</th>
                <th scope="col">Status</th>
                <th scope="col">Urgência</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var consulta in Model)
            {
                var rotaConsulta = navegacao.ParaConsulta(consulta.Id);
                var urgencia = consulta.Urgencia ? "Sim" : "Não";
                var textoBusca = mostrarPet ? consulta.PetNome : consulta.DataHora.ToString("dd/MM/yyyy");
                <tr data-lista-item="@textoBusca" data-filtro-veterinario="@consulta.VeterinarioNome"
                    data-filtro-status="@consulta.Status" data-filtro-urgencia="@urgencia">
                    <th scope="row" class="registro-contato">
                        <time datetime="@consulta.DataHora.ToString("yyyy-MM-ddTHH:mm")">@consulta.DataHora.ToString("dd/MM/yyyy HH:mm")</time>
                    </th>
                    @if (mostrarPet)
                    {
                        <td><a asp-controller="Pet" asp-action="Detalhes" asp-route-id="@consulta.PetId" asp-route-areaClinica="@areaClinica">@consulta.PetNome</a></td>
                    }
                    <td>@consulta.VeterinarioNome</td>
                    <td>@consulta.Status</td>
                    <td>@urgencia</td>
                    <td>
                        <div class="registro-acoes">
                            <a asp-controller="Consulta" asp-action="Atendimento" asp-all-route-data="@rotaConsulta"
                               aria-label="Atendimento de @consulta.PetNome em @consulta.DataHora.ToString("dd/MM/yyyy HH:mm")">
                                @(consulta.Status == StatusConsulta.Agendada && consulta.VeterinarioId == veterinarioSelecionadoId
                                    ? "Realizar atendimento"
                                    : "Ver atendimento")
                            </a>
                            @if (consulta.Status == StatusConsulta.Agendada && areaClinica is null)
                            {
                                <a asp-controller="Consulta" asp-action="Reagendar" asp-all-route-data="@rotaConsulta" data-acao-recepcao
                                   aria-label="Reagendar consulta de @consulta.PetNome em @consulta.DataHora.ToString("dd/MM/yyyy HH:mm")">Reagendar</a>
                                <a class="acao-perigosa" asp-controller="Consulta" asp-action="Atendimento" asp-all-route-data="@rotaConsulta" asp-fragment="cancelar-consulta" data-acao-recepcao
                                   aria-label="Cancelar consulta de @consulta.PetNome em @consulta.DataHora.ToString("dd/MM/yyyy HH:mm")">Cancelar</a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
