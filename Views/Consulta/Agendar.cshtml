@model VetCare.Models.ViewModels.Consulta.ConsultaAgendarViewModel
@{
    ViewData["Title"] = "Agendar consulta";
    var temOpcoes = Model.Pets.Count > 0 && Model.Veterinarios.Count > 0;
    var navegacao = NavegacaoAgenda.DaConsulta(Context.Request.Query);
}

<section class="area-panel" aria-labelledby="titulo-agendar">
    <header class="registro-cabecalho">
        <h1 id="titulo-agendar">Agendar consulta</h1>
    </header>

    @if (Model.Pets.Count == 0)
    {
        <p class="registro-aviso">Cadastre um pet para agendar a consulta.</p>
    }
    @if (Model.Veterinarios.Count == 0)
    {
        <p class="registro-aviso">É preciso ter um veterinário cadastrado para agendar a consulta.</p>
    }

    <form class="registro-formulario" asp-controller="Consulta" asp-action="Agendar"
          asp-all-route-data="navegacao.ParaConsulta()" method="post">
        <div asp-validation-summary="ModelOnly" class="registro-erro" role="alert"></div>
        <div class="formulario-campo">
            <label asp-for="PetId"></label>
            <select asp-for="PetId" asp-items="Model.Pets" required>
                <option value="">Selecione um pet</option>
            </select>
            <span asp-validation-for="PetId" class="registro-erro"></span>
        </div>
        <div class="formulario-campo">
            <label asp-for="VeterinarioId"></label>
            <select asp-for="VeterinarioId" asp-items="Model.Veterinarios" data-consulta-veterinario required>
                <option value="">Selecione um veterinário</option>
            </select>
            <span asp-validation-for="VeterinarioId" class="registro-erro"></span>
        </div>
        @Html.EditorFor(model => model.DataHora, "HorarioConsulta")
        <div class="formulario-campo">
            <label asp-for="QueixaInicial"></label>
            <textarea asp-for="QueixaInicial" rows="3" required></textarea>
            <span asp-validation-for="QueixaInicial" class="registro-erro"></span>
        </div>
        <div class="formulario-campo consulta-campo-largo">
            <label class="consulta-urgencia">
                <input asp-for="Urgencia" />
                Marcar como urgente
            </label>
        </div>
        <div class="registro-botoes">
            <a asp-controller="Consulta" asp-action="Index" asp-all-route-data="navegacao.ParaAgenda()"
               class="botao-secundario">Voltar à agenda</a>
            <button type="submit" class="botao-primario" disabled="@(!temOpcoes)">Agendar consulta</button>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/consulta-horario.js" asp-append-version="true" defer></script>
}
