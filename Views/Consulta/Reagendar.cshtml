@model VetCare.Models.ViewModels.Consulta.ConsultaReagendarViewModel
@using VetCare.Models.Enums
@{
    ViewData["Title"] = "Reagendar consulta";
    var navegacao = NavegacaoAgenda.DaConsulta(Context.Request.Query);
    var acaoVoltar = navegacao.VeioDoAtendimento ? "Atendimento" : "Index";
    var rotaVoltar = navegacao.VeioDoAtendimento ? navegacao.ParaConsulta(Model.Consulta.Id) : navegacao.ParaAgenda();
}

<section class="area-panel" aria-labelledby="titulo-reagendar">
    <header class="registro-cabecalho">
        <div>
            <h1 id="titulo-reagendar">Reagendar consulta</h1>
            <p>@Model.Consulta.PetNome · @Model.Consulta.VeterinarioNome</p>
        </div>
    </header>

    <p class="registro-aviso">Horário atual: <strong>@Model.Consulta.DataHora.ToString("dd/MM/yyyy HH:mm")</strong></p>

    <form class="registro-formulario" asp-controller="Consulta" asp-action="Reagendar"
          asp-all-route-data="navegacao.ParaConsulta(Model.Consulta.Id, navegacao.VeioDoAtendimento)"
          method="post" data-consulta-id="@Model.Consulta.Id">
        <div asp-validation-summary="ModelOnly" class="registro-erro" role="alert"></div>
        @if (Model.Consulta.Status == StatusConsulta.Agendada)
        {
            <div class="formulario-campo">
                <label asp-for="VeterinarioId"></label>
                <select asp-for="VeterinarioId" asp-items="Model.Veterinarios" data-consulta-veterinario required>
                    <option value="">Selecione um veterinário</option>
                </select>
                <span asp-validation-for="VeterinarioId" class="registro-erro"></span>
            </div>
            @Html.EditorFor(model => model.NovaDataHora, "HorarioConsulta")
        }
        <div class="registro-botoes">
            <a asp-controller="Consulta" asp-action="@acaoVoltar" asp-all-route-data="@rotaVoltar"
               class="botao-secundario">@(navegacao.VeioDoAtendimento ? "Voltar ao atendimento" : "Voltar à agenda")</a>
            @if (Model.Consulta.Status == StatusConsulta.Agendada)
            {
                <button type="submit" class="botao-primario">Salvar reagendamento</button>
            }
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/consulta-horario.js" asp-append-version="true" defer></script>
}
