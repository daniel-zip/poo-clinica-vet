@{
    var inicio = Url.Action("Index", "Home") ?? "";
    var funcionarios = new[]
    {
        (Nome: "Lívia Costa", Iniciais: "LC", Funcao: "Recepcionista", Area: "recepcao"),
        (Nome: "Rafael Mendes", Iniciais: "RM", Funcao: "Veterinário", Area: "veterinario"),
        (Nome: "Marina Alves", Iniciais: "MA", Funcao: "Administradora", Area: "administracao")
    };
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | VetCare</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" href="@(inicio + "#recepcao")" data-home-link>Vet<span>Care</span></a>
            <nav class="area-nav" aria-label="Áreas do sistema">
                <span class="nav-label">Áreas</span>
                <a class="area-link" role="link" href="@(inicio + "#recepcao")" data-area-link="recepcao">Recepção</a>
                <a class="area-link" role="link" href="@(inicio + "#veterinario")" data-area-link="veterinario">Veterinário</a>
                <a class="area-link" role="link" href="@(inicio + "#administracao")" data-area-link="administracao">Administração</a>
            </nav>
        </aside>
        <div class="app-content">
            <header class="topbar">
                <div class="active-profile" role="status">
                    <strong data-profile-name></strong>
                    <span data-profile-role></span>
                </div>
                <button class="switch-button" type="button" id="abrir-perfis">Trocar usuário</button>
            </header>
            <main id="conteudo" class="main-content" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <dialog id="escolher-perfil" aria-labelledby="titulo-perfis" aria-describedby="descricao-perfis">
        <div class="dialog-heading">
            <h2 id="titulo-perfis">Trocar usuário</h2>
            <form method="dialog">
                <button class="close-button" type="submit" aria-label="Fechar" autofocus>×</button>
            </form>
        </div>
        <p id="descricao-perfis">Escolha um funcionário para a demonstração.</p>
        <ul class="profile-list">
            @foreach (var funcionario in funcionarios)
            {
                <li>
                    <button class="profile-option" type="button" data-profile-area="@funcionario.Area" aria-pressed="false">
                        <span class="avatar" aria-hidden="true">@funcionario.Iniciais</span>
                        <span class="profile-details">
                            <strong>@funcionario.Nome</strong>
                            <span>@funcionario.Funcao</span>
                        </span>
                        <span class="profile-current" aria-hidden="true">Atual</span>
                    </button>
                </li>
            }
        </ul>
    </dialog>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
