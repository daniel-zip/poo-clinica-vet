@{
    var inicio = Url.Action("Index", "Home") ?? "";
}
<!DOCTYPE html>
<html lang="pt-BR" data-caminho-perfil="@Url.Content("~/")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | VetCare</title>
    <link rel="icon" type="image/png" href="~/img/vetcare-icone.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script src="~/js/mascaras-contato.js" asp-append-version="true" defer></script>
    <script src="~/js/filtros-lista.js" asp-append-version="true" defer></script>
</head>
<body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" href="@(inicio + "#recepcao")" data-home-link>
                <span>Vet<span class="brand-accent">Care</span></span>
                <img class="brand-icon" src="~/img/vetcare-icone.png" asp-append-version="true" width="90" height="90" alt="" />
            </a>
            <nav class="area-nav" aria-label="Áreas do sistema">
                <span class="nav-label">Áreas</span>
                <a class="area-link" role="link" href="@(inicio + "#recepcao")" data-area-link="recepcao">Recepção</a>
                <a class="area-link" role="link" href="@(inicio + "#veterinario")" data-area-link="veterinario">Veterinário</a>
                <a class="area-link" role="link" href="@(inicio + "#administracao")" data-area-link="administracao">Administração</a>
            </nav>
        </aside>
        <div class="app-content">
            <header class="topbar">
                <div class="active-profile" role="status">
                    <strong data-profile-name></strong>
                    <span data-profile-role></span>
                </div>
                <button class="switch-button" type="button" id="abrir-perfis">Trocar usuário</button>
            </header>
            <main id="conteudo" class="main-content" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>

    @await Component.InvokeAsync("SeletorPerfis")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
